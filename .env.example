# "development" allows a wildcard CORS origin and is the only mode that does.
ENVIRONMENT=development

LOG_LEVEL=INFO
# "json" for a log shipper, "text" for a terminal.
LOG_FORMAT=text

# Error tracking. Empty disables it; requires `pip install sentry-sdk`.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Comma-separated origins allowed to call this API with credentials.
# Required outside development — the app refuses to start without it.
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://user:password@host/apsara_db
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Browser sessions use an HttpOnly cookie. Enable secure cookies behind HTTPS.
AUTH_COOKIE_NAME=apsara_access_token
AUTH_COOKIE_SECURE=false

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Where the web app is served — password reset links are built from this.
APP_BASE_URL=http://localhost:3000
# Public URL of this API; a tunnel while developing webhooks locally.
API_BASE_URL=http://localhost:8000

# Any provider with an SMTP endpoint (SES, Resend, Postmark, Mailgun).
# Leave SMTP_HOST empty in development and mail is logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Apsara Assistant <no-reply@example.com>
SMTP_STARTTLS=true

# Encrypts stored page/bot tokens. Leave empty to derive it from SECRET_KEY;
# note that rotating SECRET_KEY then invalidates every stored token.
PLATFORM_TOKEN_KEY=

# Facebook Messenger. One Meta app serves every connected page.
META_APP_SECRET=
META_VERIFY_TOKEN=choose-any-string-and-paste-it-into-the-meta-dashboard
GRAPH_API_VERSION=v21.0

# "inline" runs queued work inside the web process; "worker" leaves it to
# `python -m app.worker`. Jobs are persisted either way.
JOB_RUNNER=inline
JOB_LEASE_SECONDS=300
JOB_POLL_SECONDS=2.0
JOB_RETENTION_DAYS=7

# Assistant replies one seller may spend per day. 0 disables the ceiling.
AI_DAILY_REPLY_LIMIT=500
AI_DAILY_DRAFT_LIMIT=100
MAX_ATTACHMENT_BYTES=10000000

PASSWORD_RESET_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
CODE_REQUEST_COOLDOWN_SECONDS=60

# Failed sign-ins one account may accumulate before /auth/login starts
# refusing it, and the window they are counted over. 0 disables throttling.
LOGIN_MAX_ATTEMPTS=10
# The same, per client address, across every account it tries. Deliberately
# loose: an office or a mobile network shares one address. 0 counts by
# account only.
LOGIN_MAX_ATTEMPTS_PER_IP=50
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Set true ONLY when a proxy you control sets X-Forwarded-For. With nothing
# stripping an inbound header, any caller could forge it and slip past the
# per-address ceiling.
TRUST_PROXY_HEADERS=false
