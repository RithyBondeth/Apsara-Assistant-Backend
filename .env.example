# "development" allows a wildcard CORS origin and is the only mode that does.
ENVIRONMENT=development

LOG_LEVEL=INFO
# "json" for a log shipper, "text" for a terminal.
LOG_FORMAT=text

# Error tracking. Empty disables it; requires `pip install sentry-sdk`.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Comma-separated origins allowed to call this API with credentials.
# Required outside development — the app refuses to start without it.
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://user:password@host/apsara_db
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Browser sessions use an HttpOnly cookie. Enable secure cookies behind HTTPS.
AUTH_COOKIE_NAME=apsara_access_token
AUTH_COOKIE_SECURE=false

# Answers customers, drafts orders and reads receipt screenshots.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low, medium, high, xhigh or max — lower is faster and cheaper.
ANTHROPIC_EFFORT=medium

# Where the web app is served — password reset links are built from this.
APP_BASE_URL=http://localhost:3000
# Public URL of this API; a tunnel while developing webhooks locally.
API_BASE_URL=http://localhost:8000

# Any provider with an SMTP endpoint (SES, Resend, Postmark, Mailgun).
# Leave SMTP_HOST empty in development and mail is logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Apsara Assistant <no-reply@example.com>
SMTP_STARTTLS=true

# Encrypts stored page/bot tokens. Leave empty to derive it from SECRET_KEY;
# note that rotating SECRET_KEY then invalidates every stored token.
PLATFORM_TOKEN_KEY=

# Facebook Messenger. One Meta app serves every connected page.
META_APP_SECRET=
META_VERIFY_TOKEN=choose-any-string-and-paste-it-into-the-meta-dashboard
GRAPH_API_VERSION=v21.0

# "inline" runs queued work inside the web process; "worker" leaves it to
# `python -m app.worker`. Jobs are persisted either way.
JOB_RUNNER=inline
JOB_LEASE_SECONDS=300
JOB_POLL_SECONDS=2.0
JOB_RETENTION_DAYS=7

# Assistant replies one seller may spend per day. 0 disables the ceiling.
AI_DAILY_REPLY_LIMIT=500
AI_DAILY_DRAFT_LIMIT=100
# Receipt scans (vision) per seller per day. 0 disables scanning.
AI_DAILY_RECEIPT_LIMIT=200
MAX_ATTACHMENT_BYTES=10000000

# Where photos, payment QRs and customer attachments are kept: "database"
# (Postgres) or "s3" — any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
# The bucket can stay private; the API serves every file itself. After
# switching, move existing files with `python -m app.scripts.move_media`.
MEDIA_STORAGE=database
S3_BUCKET=
# Empty for AWS; https://<account-id>.r2.cloudflarestorage.com for R2.
S3_ENDPOINT_URL=
# "auto" for R2.
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=media

# Dynamic KHQR, checked against Bakong. A token comes from registering at
# https://api-bakong.nbc.gov.kh and lasts 90 days; sellers may store their own
# in Settings, and this one is used for those who have not. The API answers
# Cambodian addresses only: hosted abroad, point BAKONG_API_URL at a relay.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
KHQR_EXPIRE_MINUTES=60
KHQR_POLL_SECONDS=20

PASSWORD_RESET_EXPIRE_MINUTES=30
# Sign-up: accounts one client address may create per window (0 = no cap),
# and how long the emailed confirmation link works. Password sign-in waits
# for that link, so production needs SMTP_HOST set.
REGISTER_MAX_PER_IP=5
REGISTER_WINDOW_MINUTES=60
EMAIL_VERIFY_EXPIRE_HOURS=48
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
CODE_REQUEST_COOLDOWN_SECONDS=60

# Failed sign-ins one account may accumulate before /auth/login starts
# refusing it, and the window they are counted over. 0 disables throttling.
LOGIN_MAX_ATTEMPTS=10
# The same, per client address, across every account it tries. Deliberately
# loose: an office or a mobile network shares one address. 0 counts by
# account only.
LOGIN_MAX_ATTEMPTS_PER_IP=50
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Set true ONLY when a proxy you control sets X-Forwarded-For. With nothing
# stripping an inbound header, any caller could forge it and slip past the
# per-address ceiling.
TRUST_PROXY_HEADERS=false
# The header that proxy writes the caller's address into. X-Forwarded-For is
# read from its right-most entry, the one the proxy appended. Behind Railway
# use X-Real-IP.
CLIENT_IP_HEADER=X-Forwarded-For
