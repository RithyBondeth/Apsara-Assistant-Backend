# ─────────────────────────────────────────────────────────────────────────────
# Apsara Assistant — Backend environment variables
#
# Copy this file to `.env` and fill in the values:   cp .env.example .env
# Per-environment templates live in `deploy/` (.env.local, .env.dev,
# .env.production). Never commit a real `.env` — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# One of: local | dev | production
# In "production" the interactive /docs, /redoc and /openapi.json are disabled.
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────
# PostgreSQL connection string.
#   Local via docker-compose:  postgresql://apsara:apsara@localhost:5432/apsara
#   Managed (dev/prod):        postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql://apsara:apsara@localhost:5432/apsara

# JWT signing key. Generate a strong one:  openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080    # 7 days

# Fernet key encrypting stored integration secrets (bot tokens, app secret) at
# rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If blank, a key is derived from SECRET_KEY (OK for local; set an explicit key
# in dev/prod so rotating SECRET_KEY never orphans encrypted rows).
ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# NEVER use "*" here — credentials are enabled.
#   local: http://localhost:3000
#   prod:  https://app.apsara.example.com
CORS_ORIGINS=http://localhost:3000

# ── Rate limiting (public website widget endpoint) ───────────────────────────
# Throttles POST /api/v1/webhooks/website/{id} per (integration, client IP).
# Per-process — with N workers/replicas the effective limit is N × this.
WEBSITE_RATE_LIMIT=20
WEBSITE_RATE_WINDOW_SECONDS=60

# ── Public URL ───────────────────────────────────────────────────────────────
# The externally reachable base URL of THIS API. Used to build the platform
# webhook callback URLs (Telegram/Messenger). Leave blank for local unless you
# are tunnelling (e.g. ngrok) to receive real webhooks.
#   dev/prod: https://api.apsara.example.com
PUBLIC_BASE_URL=

# ── AI (OpenAI) ──────────────────────────────────────────────────────────────
# Required for the chat + webhook auto-reply pipeline to work.
OPENAI_API_KEY=

# ── Image uploads (Cloudinary) ───────────────────────────────────────────────
# Required for POST/DELETE /api/v1/uploads/image. If blank, upload endpoints
# return 503 (the rest of the API still works).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Storage: AWS S3 (optional — reserved, not yet wired) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-1
