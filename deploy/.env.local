# Apsara Assistant — LOCAL environment template
# Usage:  cp deploy/.env.local .env   (then fill OPENAI_API_KEY etc.)
# Pairs with docker-compose.yml (Postgres on localhost:5432).

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG

# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://apsara:apsara@localhost:5432/apsara

SECRET_KEY=dev-only-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:3000

# Web app base URL — used to build password-reset links in emails
FRONTEND_BASE_URL=http://localhost:3000

# Email (SMTP). Leave SMTP_HOST blank in local dev: reset links and OTP codes
# are logged to the API console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Apsara Assistant <no-reply@apsara.example.com>

# Only needed if tunnelling (ngrok) to test real Telegram/Messenger webhooks
PUBLIC_BASE_URL=

OPENAI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
