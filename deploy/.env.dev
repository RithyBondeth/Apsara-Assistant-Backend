# Apsara Assistant — DEV / STAGING environment template
# Fill these in your host's secret manager (Railway/Render/Fly/etc.),
# do NOT commit real values.

ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO

# Managed Postgres connection string from your provider
DATABASE_URL=postgresql://USER:PASSWORD@DEV_DB_HOST:5432/apsara

# Generate: openssl rand -hex 32
SECRET_KEY=__set_in_secret_manager__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Your deployed staging frontend origin(s)
CORS_ORIGINS=https://dev.apsara.example.com

# Public URL of this API on dev (used for webhook callbacks)
PUBLIC_BASE_URL=https://api-dev.apsara.example.com

OPENAI_API_KEY=__set_in_secret_manager__

CLOUDINARY_CLOUD_NAME=__set_in_secret_manager__
CLOUDINARY_API_KEY=__set_in_secret_manager__
CLOUDINARY_API_SECRET=__set_in_secret_manager__
