# Apsara Assistant — PRODUCTION environment template
# NEVER commit real values. Set these in your host's secret manager.
# Every placeholder below MUST be replaced before going live.

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# Managed, backed-up Postgres. Require SSL where supported, e.g. ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@PROD_DB_HOST:5432/apsara?sslmode=require

# Generate a UNIQUE production key: openssl rand -hex 32
SECRET_KEY=__set_in_secret_manager__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# REQUIRED in prod — a dedicated key so rotating SECRET_KEY never orphans data.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=__set_in_secret_manager__

# Production frontend origin(s) only — comma-separated, no trailing slash
CORS_ORIGINS=https://app.apsara.example.com

# Public URL of the production API (used for webhook callbacks)
PUBLIC_BASE_URL=https://api.apsara.example.com

OPENAI_API_KEY=__set_in_secret_manager__

CLOUDINARY_CLOUD_NAME=__set_in_secret_manager__
CLOUDINARY_API_KEY=__set_in_secret_manager__
CLOUDINARY_API_SECRET=__set_in_secret_manager__
